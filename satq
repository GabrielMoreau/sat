#!/bin/bash
#
# Script: /usr/bin/satq
# Description: list SAT jobs
# Version: @VERSION@
#
# 2026/07/24 Gabriel Moreau <Gabriel.Moreau@univ-grenoble-alpes.fr>

set -euo pipefail

export PATH=/bin:/sbin:/usr/bin:/usr/sbin
export LANG=C

JOBDIR='/var/lib/sat/job'
SYSTEMDDIR='/etc/systemd/system'

usage() {
  cat <<EOF
Usage:
  satq                        List scheduled jobs
  satq -f|--failed            List failed jobs
  satq JOB_ID                 Show detailed job information
  satq -h|--help              Show this help
  satq -V|--version           Show version
EOF
}

normalize_id() {
  printf "%06d" "$1"
}

get_command() {
  local id file 
  id="$1"
  file="${JOBDIR}/$id.sh"

  if [ ! -f "${file}" ]
  then
    echo '-'
    return
  fi

  # Ignore boilerplate
  grep -vE '^(#!/|set |\s*$)' "${file}" | head -1 || echo '-'
}

get_state() {
  local id statusfile state
  id="$1"
  statusfile="${JOBDIR}/${id}.status"

  if systemctl is-active --quiet "sat-run@${id}.service"
  then
    echo "running"
    return
  fi

  if [ -f "${statusfile}" ]
  then
    state=$(sed -n 's/^state=//p' "${statusfile}")

    case "${state:-}" in
      failed)
        echo 'failed'
        ;;
      *)
        echo "unknown(${state:-empty})"
        ;;
    esac
    return
  fi

  echo 'waiting'
}

list_jobs() {
  printf "%-8s %-18s %-10s %s\n" "ID" "NEXT RUN" "STATE" "COMMAND"

  for timer in "${SYSTEMDDIR}"/sat-*.timer
  do
    [ -e "$timer" ] || continue

    local id next_run state cmd
    id=$(basename "$timer" .timer)
    id=${id#sat-}
    next_run=$(systemctl show "sat-${id}.timer" -p NextElapseUSecRealtime --value 2>/dev/null || echo '-')
    if [ "${next_run}" != "-" ] && [ -n "${next_run}" ]
    then
      next_run=$(date -d "${next_run}" "+%F %H:%M")
    fi
    state=$(get_state "${id}")
    cmd=$(get_command "${id}")

    printf "%-8s %-18s %-10s %s\n" "${id}" "${next_run}" "${state}" "${cmd}"
  done
}

list_failed() {
  printf "%-8s %-18s %-8s %s\n" "ID" "LAST RUN" "EXIT" "COMMAND"

  for statusfile in "${JOBDIR}"/*.status
  do
    [ -e "$statusfile" ] || continue

    local id last_run exitcode cmd
    id=$(basename "${statusfile}" .status)
    last_run=$(grep '^date_end=' "${statusfile}" | cut -d= -f2- || echo '-')
    exitcode=$(grep '^exit=' "${statusfile}" | cut -d= -f2  || echo '-')
    cmd=$(get_command "${id}")

    printf "%-8s %-18s %-8s %s\n" "${id}" "${last_run}" "${exitcode}" "${cmd}"
  done
}

show_job() {
  local id
  id=$(normalize_id "$1")

  local jobfile statusfile timerfile
  jobfile="${JOBDIR}/${id}.sh"
  statusfile="${JOBDIR}/${id}.status"
  timerfile="${SYSTEMDDIR}/sat-${id}.timer"

  if [ ! -f "${jobfile}" ] && [ ! -f "${timerfile}" ]
  then
    echo "satq: job ${id} not found" >&2
    exit 1
  fi

  echo "Job ID:       ${id}"
  if [ -f "${statusfile}" ]
  then
    echo "State:        failed"
    grep '^exit=' "${statusfile}"     | sed 's/^/Exit status:  /' || true
    grep '^date_end=' "${statusfile}" | sed 's/^/Last run:     /' || true
  else
    echo "State:        waiting"
  fi

  echo ''
  if [ -f "${timerfile}" ]
  then
    echo "Timer:"
    echo "------------------------------------------------------------"
    grep '^OnCalendar=' "${timerfile}" | sed 's/^/Scheduled:    /' || true
    echo "------------------------------------------------------------"
    echo
  fi

  if [ -f "${jobfile}" ]
  then
    echo "Script:"
    echo "------------------------------------------------------------"
    cat "${jobfile}"
    echo "------------------------------------------------------------"
  fi

  echo ''
  echo "Journal:"
  echo "------------------------------------------------------------"
  journalctl -u "sat-run@${id}.service" --no-pager -n 20 || true
  echo "------------------------------------------------------------"
}

case "${1:-}" in
  -h|--help)
    usage
    exit 0
    ;;

  -V|--version)
    echo "satq @VERSION@"
    exit 0
    ;;

  -f|--failed)
    list_failed
    ;;

  '')
    list_jobs
    ;;

  *[!0-9]*)
    echo "satq: invalid argument: $1" >&2
    usage >&2
    exit 2
    ;;

  *)
    show_job "$1"
    ;;
esac
